# APP_URL: The URL where this applet is hosted.
# Used for HTTP-Referer header on OpenRouter requests.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret used for AES-256-GCM encryption of stored session credentials.
SESSION_SECRET="MY_SESSION_SECRET"

# PAID_MODELS_PASSWORD: Optional password required before users can select or run paid OpenRouter models.
# Works both on the Node server and automatically hashed at build time on Cloudflare Pages.
PAID_MODELS_PASSWORD=""

# Optional server-side default provider keys & base URLs (Node server mode only).
# If omitted, each user configures their preferred provider & API key directly in the app.
OPENROUTER_API_KEY=""
OPENROUTER_DEFAULT_MODEL="openrouter/free"

# Direct first-party AI APIs
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
MISTRAL_API_KEY=""
DEEPSEEK_API_KEY=""
GEMINI_API_KEY=""
XAI_API_KEY=""

# Alternative multi-model routers & fast inference providers
REQUESTY_API_KEY=""
HF_TOKEN=""
TOGETHER_API_KEY=""
GROQ_API_KEY=""
CEREBRAS_API_KEY=""

# Custom / local OpenAI-compatible endpoint (e.g. Ollama, LM Studio, vLLM, LiteLLM)
CUSTOM_BASE_URL=""
CUSTOM_API_KEY=""
